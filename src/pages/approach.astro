---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { phases } from '../data/site';
import { breadcrumbSchema } from '../lib/schema';

/* The expanded version of the homepage's four-phase block. Same phases, same
   order, same numbering — the extra material is what each phase involves and
   what it produces, which is the detail the homepage deliberately leaves out.

   The per-phase detail below is structural rather than factual: it describes
   how TGM works, not what results were achieved. Nothing here is a claim that
   needs a source. */

const detail = [
  {
    involves: [
      'Interviews with the people doing the work, not only the people managing it',
      'Walking a live job end to end, from first contact to money received',
      'A look at whatever data exists, including the spreadsheets nobody mentions',
      'A written diagnosis, circulated before anyone proposes a solution',
    ],
    duration: 'Typically two to four weeks',
    stopHere:
      'You have a written, evidenced view of what is limiting the business. That is a useful thing to own whether or not we do anything else together.',
  },
  {
    involves: [
      'A target-state design for the process, structure or reporting in question',
      'Sequencing and dependencies, so the work runs in a survivable order',
      'A cost and effort estimate honest enough to be argued with',
      'Agreement on what success is measured by, before implementation starts',
    ],
    duration: 'Typically two to six weeks',
    stopHere:
      'You have a specification another party could implement. Some clients take this in-house, and that is a legitimate outcome rather than a lost sale.',
  },
  {
    involves: [
      'Working alongside the people who will own the process afterwards',
      'Building in the open, so decisions are visible while they are reversible',
      'Regular checkpoints against the measures agreed in phase two',
      'Documentation written by your team, in their language',
    ],
    duration: 'Varies with scope, but agreed up front rather than open-ended',
    stopHere:
      'The change is live and running. Most engagements could end here, and some should.',
  },
  {
    involves: [
      'Measurement that continues after we leave, owned by someone named',
      'The management habits that decide whether a change survives a busy quarter',
      'A review at a defined interval, agreed at the start',
      'An honest assessment of what did not hold, and why',
    ],
    duration: 'A defined review period, not a retainer by default',
    stopHere:
      'This is the phase most transformation work skips, which is why so much of it quietly reverses within a year.',
  },
];

const combined = phases.map((phase, i) => ({ ...phase, ...detail[i] }));
---

<Base
  title="Our approach: four phases, in order | TGM Group"
  description="How a TGM Group engagement runs: diagnose, design, implement, embed. Four phases in order, with a defined stopping point after each one."
  jsonLd={[breadcrumbSchema([{ name: 'Approach', href: '/approach/' }])]}
>
  <PageHero
    accent="gold"
    title="Four phases, in order. You can stop after any one of them."
    lead="Every phase produces something you own and can use on its own. That is deliberate. An engagement that only pays off at the end is one you cannot get out of."
  />

  <div class="wrap">
    {
      combined.map((phase) => (
        <section class:list={['phase-section', phase.accent === 'gold' && 'phase-section-gold']}>
          <div class="phase-grid">
            <div class="phase-head">
              <p class="t-mono phase-label">
                {phase.number} · {phase.name}
              </p>
              <h2 class="t-h2 phase-title">{phase.headline}</h2>
            </div>

            <div class="phase-detail">
              <p class="t-lead phase-summary">{phase.body}</p>

              <div class="phase-columns">
                <div>
                  <h3 class="t-caption detail-heading">What it involves</h3>
                  <ul class="detail-list">
                    {phase.involves.map((item) => (
                      <li class="t-body-sm">{item}</li>
                    ))}
                  </ul>
                </div>

                <div class="phase-meta">
                  <div>
                    <h3 class="t-caption detail-heading">How long</h3>
                    <p class="t-body-sm meta-body">{phase.duration}</p>
                  </div>
                  <div>
                    <h3 class="t-caption detail-heading">If you stop here</h3>
                    <p class="t-body-sm meta-body">{phase.stopHere}</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
      ))
    }
  </div>

  <CtaBand />
</Base>

<style>
  .phase-section {
    padding-block: var(--space-6);
    border-top: 3px solid var(--navy);
  }

  .phase-section-gold {
    border-top-color: var(--gold);
  }

  .phase-grid {
    display: grid;
    grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
  }

  /* --gold-ink, not --gold: gold on white is 1.76:1 and cannot be text. */
  .phase-label {
    color: var(--gold-ink);
  }

  .phase-title {
    margin-top: var(--space-3);
    color: var(--ink);
  }

  .phase-detail {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .phase-summary {
    color: var(--ink-muted);
  }

  .phase-columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-5);
  }

  .detail-heading {
    margin: 0 0 var(--space-3);
    color: var(--ink);
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .detail-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .detail-list li {
    position: relative;
    padding-left: var(--space-4);
    color: var(--ink-muted);
  }

  .detail-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 8px;
    height: 2px;
    background: var(--gold);
  }

  .phase-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-left: var(--space-5);
    border-left: 1px solid var(--hairline);
  }

  .meta-body {
    color: var(--ink-muted);
  }

  @media (max-width: 900px) {
    .phase-grid,
    .phase-columns {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
    }
    .phase-meta {
      padding-left: 0;
      padding-top: var(--space-4);
      border-left: none;
      border-top: 1px solid var(--hairline);
    }
    .phase-section {
      padding-block: var(--space-5);
    }
  }
</style>
