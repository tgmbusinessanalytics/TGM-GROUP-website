---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { phases } from '../data/site';
import { breadcrumbSchema } from '../lib/schema';

/* The expanded version of the homepage's four-phase block. Same phases, same
   order, same numbering — the extra material is what each phase involves and
   what it produces, which is the detail the homepage deliberately leaves out.

   The per-phase detail below is structural rather than factual: it describes
   how TGM works, not what results were achieved. Nothing here is a claim that
   needs a source. */

const detail = [
  {
    involves: [
      'A review of the files and registers you use now',
      'Two interviews: the person who keeps the records and the person who uses the reports',
      'An examination of the real data, including the spreadsheets nobody mentions',
      'Findings and a scoped build specification, written for you',
    ],
    duration: 'Three weeks, fixed fee, paid before work starts',
    stopHere:
      'You have every defect named in your own numbers, and a specification you own outright. That is a useful thing to hold whether or not we do anything else together. If you sign a build within 30 days, the fee is credited against it.',
  },
  {
    involves: [
      'A working system on your own tools, running on your real data',
      'Scope, price and acceptance criteria agreed in writing before work begins',
      'Roles, approvals and capture that match how your sites actually work',
      'Written acceptance from you before the build is complete',
    ],
    duration: 'Set by the specification and agreed up front, not open-ended',
    stopHere:
      'The system is live and running. Many engagements could end here, and some should.',
  },
  {
    involves: [
      'Fixes, changes and support on the delivered system',
      'Up to five hours a month, planned rather than ad hoc',
      'Work beyond five hours quoted before it starts',
      'Offered only after acceptance, never bundled into the build price',
    ],
    duration: 'Six months minimum, then month to month',
    stopHere:
      'You can end it after the minimum term. A system that nobody looks after drifts, which is why the option exists, but it is an option.',
  },
];

const combined = phases.map((phase, i) => ({ ...phase, ...detail[i] }));
---

<Base
  title="Our approach: three steps, in order | TGM Group"
  description="How a TGM Group engagement runs: diagnose, build, support. Three steps in order, with a defined stopping point after each one."
  jsonLd={[breadcrumbSchema([{ name: 'Approach', href: '/approach/' }])]}
>
  <PageHero
    accent="gold"
    title="Three steps, in order. You can stop after any one of them."
    lead="Every phase produces something you own and can use on its own. That is deliberate. An engagement that only pays off at the end is one you cannot get out of."
  />

  <div class="wrap">
    {
      combined.map((phase) => (
        <section class:list={['phase-section', phase.accent === 'gold' && 'phase-section-gold']}>
          <div class="phase-grid">
            <div class="phase-head">
              <p class="t-mono phase-label">
                {phase.number} · {phase.name}
              </p>
              <h2 class="t-h2 phase-title">{phase.headline}</h2>
            </div>

            <div class="phase-detail">
              <p class="t-lead phase-summary">{phase.body}</p>

              <div class="phase-columns">
                <div>
                  <h3 class="t-caption detail-heading">What it involves</h3>
                  <ul class="detail-list">
                    {phase.involves.map((item) => (
                      <li class="t-body-sm">{item}</li>
                    ))}
                  </ul>
                </div>

                <div class="phase-meta">
                  <div>
                    <h3 class="t-caption detail-heading">How long</h3>
                    <p class="t-body-sm meta-body">{phase.duration}</p>
                  </div>
                  <div>
                    <h3 class="t-caption detail-heading">If you stop here</h3>
                    <p class="t-body-sm meta-body">{phase.stopHere}</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
      ))
    }
  </div>

  <CtaBand />
</Base>

<style>
  .phase-section {
    padding-block: var(--space-6);
    border-top: 3px solid var(--navy);
  }

  .phase-section-gold {
    border-top-color: var(--gold);
  }

  .phase-grid {
    display: grid;
    grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
  }

  /* --gold-ink, not --gold: gold on white is 1.76:1 and cannot be text. */
  .phase-label {
    color: var(--gold-ink);
  }

  .phase-title {
    margin-top: var(--space-3);
    color: var(--ink);
  }

  .phase-detail {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .phase-summary {
    color: var(--ink-muted);
  }

  .phase-columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-5);
  }

  .detail-heading {
    margin: 0 0 var(--space-3);
    color: var(--ink);
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .detail-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .detail-list li {
    position: relative;
    padding-left: var(--space-4);
    color: var(--ink-muted);
  }

  .detail-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 8px;
    height: 2px;
    background: var(--gold);
  }

  .phase-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-left: var(--space-5);
    border-left: 1px solid var(--hairline);
  }

  .meta-body {
    color: var(--ink-muted);
  }

  @media (max-width: 900px) {
    .phase-grid,
    .phase-columns {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
    }
    .phase-meta {
      padding-left: 0;
      padding-top: var(--space-4);
      border-left: none;
      border-top: 1px solid var(--hairline);
    }
    .phase-section {
      padding-block: var(--space-5);
    }
  }
</style>
