---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Motif from '../components/Motif.astro';
import ServiceCard from '../components/ServiceCard.astro';
import PhaseStep from '../components/PhaseStep.astro';
import CtaBand from '../components/CtaBand.astro';
import { cta, sectors, phases, practices } from '../data/site';
import { organizationSchema, localBusinessSchema } from '../lib/schema';

const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base
  title="TGM Group: operational systems and analytics for service contractors"
  description="TGM Group builds working systems for site-based service contractors in South Africa: attendance, compliance, job status and client reporting, built on the tools you already run. Book the diagnostic."
  jsonLd={[organizationSchema(), localBusinessSchema()]}
>
  {/* 2. Hero -----------------------------------------------------------*/}
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <span class="rule" aria-hidden="true"></span>
        <h1 class="t-hero hero-title">
          Replace the spreadsheet your client is waiting on
        </h1>
        <p class="t-lead hero-lead">
          TGM Group builds working systems and analytics for site-based service
          contractors: attendance, compliance files, job status and the client
          reporting that comes out of them. Built on the tools you already run.
        </p>
        <div class="hero-actions">
          <Button href={cta.href} variant="gold">{cta.label}</Button>
          <Button href="#approach" variant="outline">See how we work</Button>
        </div>
      </div>

      <Motif />
    </div>
  </section>

  {/* 3. Proof strip -------------------------------------------------------
       Sector words, not logo placeholders. Until there is written permission
       to use client logos, this is the honest version. */}
  <section class="proof">
    <div class="wrap proof-inner">
      <p class="t-nav proof-label">Built for site-based service contractors</p>
      <ul class="proof-sectors">
        {
          sectors.map((sector) => (
            <li class="proof-sector">
              {sector ?? (
                <>
                  <span class="placeholder" aria-hidden="true">
                    [Sector]
                  </span>
                  <span class="sr-only">Fourth sector to be supplied</span>
                </>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* 4. Statement ---------------------------------------------------------
       The section that does the persuading. It stays dark, it stays short,
       and nothing else gets added to it. */}
  <section class="statement on-dark">
    <div class="wrap statement-inner">
      <h2 class="t-h2-dark statement-heading">
        You do not have a reporting problem. You have a capture problem.
      </h2>
      <div class="statement-body">
        <span class="rule" aria-hidden="true"></span>
        <p class="t-lead">
          When a business is spread across client sites, the same wall tends to
          appear. A client asks for proof of attendance, a certificate before an
          audit, or a monthly report on a deadline. The report is rarely the
          problem. The record underneath it is: timesheets reconciled by hand,
          files chased by email, job status that lives in one supervisor's head.
        </p>
        <p class="t-lead">
          You cannot report your way out of that. We find the failure, build the
          system that captures the work once, and stay on to keep it working.
        </p>
      </div>
    </div>
  </section>

  {/* 5. Services --------------------------------------------------------*/}
  <section id="services" class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="rule rule-teal" aria-hidden="true"></span>
          <h2 class="t-h2 section-title">What we do</h2>
        </div>
        <p class="t-body section-intro">
          Five areas of work across two divisions. Systems comes first and
          Analytics follows, because a report is only as good as the data under it.
        </p>
      </div>

      <div class="services-grid">
        {
          services.map((service) => (
            <ServiceCard
              title={service.data.title}
              body={service.data.summary}
              accent={service.data.accent}
            />
          ))
        }

        {/* The sixth cell is a CTA in the grid, not a seventh service. */}
        <ServiceCard
          variant="cta"
          title="Not sure where to start?"
          body="That is what the diagnostic is for: three weeks to find where the actual failure sits, and what it costs you, before anyone proposes a build."
          href={cta.href}
          ctaLabel={cta.label}
        />
      </div>
    </div>
  </section>

  {/* 6. Approach --------------------------------------------------------*/}
  <section id="approach" class="section approach">
    <div class="wrap">
      <span class="rule" aria-hidden="true"></span>
      <h2 class="t-h2 section-title">How an engagement runs</h2>
      <p class="t-lead approach-intro">
        Three steps, in order. You can stop after any one of them.
      </p>

      <div class="phase-grid">
        {
          phases.map((phase) => (
            <PhaseStep
              number={phase.number}
              name={phase.name}
              headline={phase.headline}
              body={phase.body}
              accent={phase.accent}
            />
          ))
        }
      </div>
    </div>
  </section>

  {/* 7. Evidence --------------------------------------------------------*/}
  <section id="evidence" class="section">
    <div class="wrap evidence-inner">
      <div class="evidence-copy">
        <span class="rule rule-teal" aria-hidden="true"></span>
        <h2 class="t-h2 section-title">Evidence, not adjectives</h2>
        <p class="t-body evidence-body">
          TGM Group is new, so there are no case studies to show you yet. When
          there are, every figure will name the client, the sector and the
          period it was measured over, and we will not publish one until the
          client has agreed to it being public.
        </p>
      </div>

    </div>
  </section>

  {/* 8. Practices ---------------------------------------------------------
       The coloured top border appears here and nowhere else. It is carrying
       real information — which practice — not decoration. */}
  <section id="about" class="section practices">
    <div class="wrap">
      <h2 class="t-h2 section-title">Two divisions, one group</h2>

      <div class="practice-grid">
        {
          practices.map((practice) => (
            <article class:list={['practice-card', `practice-${practice.accent}`]}>
              <h3 class="t-h3">{practice.name}</h3>
              <p class="t-body-sm practice-body">{practice.description}</p>
              <ul class="practice-list">
                {practice.focus.map((item) => (
                  <li class="t-body-sm">{item}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* 9. CTA band --------------------------------------------------------*/}
  <CtaBand />
</Base>

<style>
  /* ---- Hero ------------------------------------------------------------ */

  .hero-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding-block: var(--space-7);
  }

  .hero-copy {
    flex: 1 1 auto;
    min-width: 0;
  }

  .hero-title {
    margin-top: var(--space-4);
    max-width: 740px;
    color: var(--ink);
  }

  .hero-lead {
    margin-top: var(--space-4);
    max-width: 620px;
    color: var(--ink-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  /* ---- Proof strip ----------------------------------------------------- */

  .proof {
    background: var(--surface-sunken);
  }

  .proof-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 148px;
    padding-block: var(--space-4);
  }

  .proof-label {
    color: var(--ink-muted);
    flex: none;
  }

  .proof-sectors {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .proof-sector {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 19px;
    color: var(--navy);
  }

  /* ---- Statement ------------------------------------------------------- */

  .statement {
    background: var(--surface-deep);
    padding-block: var(--space-7);
  }

  .statement-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
  }

  .statement-heading {
    max-width: 620px;
    color: var(--ink-inverse);
  }

  .statement-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .statement-body p {
    color: var(--ink-inverse-muted);
  }

  /* ---- Shared section furniture ---------------------------------------- */

  .section-title {
    margin-top: var(--space-4);
    color: var(--ink);
  }

  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .section-intro {
    max-width: 460px;
    text-align: right;
    color: var(--ink-muted);
  }

  /* ---- Services grid ---------------------------------------------------- */

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  /* ---- Approach --------------------------------------------------------- */

  .approach {
    background: var(--surface-sunken);
  }

  .approach-intro {
    margin-top: var(--space-4);
    max-width: 620px;
    color: var(--ink-muted);
  }

  .phase-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    margin-top: var(--space-6);
  }

  /* ---- Evidence --------------------------------------------------------- */

  .evidence-inner {
    display: grid;
    grid-template-columns: minmax(0, 640px);
    gap: var(--space-6);
    align-items: start;
  }

  .evidence-copy {
    max-width: 420px;
  }

  .evidence-body {
    margin-block: var(--space-4);
    color: var(--ink-muted);
  }

  .stat-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }

  /* ---- Practices -------------------------------------------------------- */

  .practice-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .practice-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--hairline);
    border-top: 5px solid var(--gold);
    border-radius: var(--radius-md);
  }

  .practice-teal {
    border-top-color: var(--teal);
  }

  .practice-body {
    color: var(--ink-muted);
  }

  .practice-list {
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .practice-list li {
    position: relative;
    padding-left: var(--space-4);
    color: var(--ink-muted);
  }

  /* A 8x2 gold tick-mark. Decorative: the list is already a list. */
  .practice-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 8px;
    height: 2px;
    background: var(--gold);
  }

  .practice-teal .practice-list li::before {
    background: var(--teal);
  }

  /* ---- Responsive -------------------------------------------------------
     Three breakpoints only: the grids collapse 3->2 then 2->1, and the two
     split sections stack. */

  @media (max-width: 1100px) {
    .services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .phase-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5);
    }
    .evidence-inner {
      grid-template-columns: minmax(0, 1fr);
    }
    .stat-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .hero-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-5);
      padding-block: var(--space-6);
    }
    .statement-inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }
    .section-head {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }
    .section-intro {
      text-align: left;
    }
    .practice-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 768px) {
    .services-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .phase-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .proof-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
      min-height: 0;
    }
    .proof-sectors {
      gap: var(--space-3) var(--space-4);
    }
    .statement,
    .hero-inner {
      padding-block: var(--section-m);
    }

    /* Two stat blocks on mobile, stacked. The third is dropped rather than
       squeezed — the design spec is explicit about this. */
    .stat-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }
    .stat-cell:nth-child(3) {
      display: none;
    }
  }
</style>
