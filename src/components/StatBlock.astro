---
/* One measured result.

   `figure` is null until Trevor supplies a number with a named client and a
   period, and the block renders a visible [__] placeholder in the meantime.
   That is deliberate. An unsourced number on a consulting site is worse than
   no number, and a placeholder that looks like a placeholder is the only thing
   that stops one being quietly filled with something plausible.

   The source line is always rendered, including while it says what is still
   missing. A figure without a source does not ship. */

interface Props {
  figure: string | null;
  unit: string;
  description: string;
  source: string;
}

const { figure, unit, description, source } = Astro.props;
---

<div class="stat">
  <span class="rule rule-stat" aria-hidden="true"></span>

  <p class="stat-figure">
    {
      figure ? (
        <span class="t-bignum">{figure}</span>
      ) : (
        <>
          {/* An empty dashed slot, NOT the literal "[__]" used elsewhere.
              At 60-72px in Archivo Bold those four characters fuse: the
              brackets become tall strokes and the two underscores join into a
              single low bar, so the whole thing reads as a broken glyph rather
              than as a blank awaiting a number. A dashed outline is the
              universal signal for "content goes here" and cannot be mistaken
              for a font that failed to load.

              Sized in em off the bignum step so it tracks the type scale, and
              it keeps the line's height so the three blocks stay aligned
              whether or not a figure is present. */}
          <span class="t-bignum figure-slot" aria-hidden="true" />
          <span class="sr-only">Figure to be supplied</span>
        </>
      )
    }
    <span class="stat-unit">{unit}</span>
  </p>

  <p class="stat-description">{description}</p>
  <p class="t-caption stat-source">{source}</p>
</div>

<style>
  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .stat-figure {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    color: var(--ink);
  }

  /* The empty slot where a figure will go. Width is about two digits at the
     bignum step, so a real number dropping in later barely shifts the layout.
     --border-strong, not --hairline: this is carrying meaning, so it has to
     clear 3:1. */
  .figure-slot {
    display: inline-block;
    width: 1.35em;
    height: 0.72em;
    border: 2px dashed var(--border-strong);
    border-radius: 2px;
    vertical-align: baseline;
  }

  .stat-unit {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 700;
    color: var(--ink-muted);
  }

  .stat-description {
    font-size: 18px;
    line-height: 1.5;
    color: var(--ink);
  }

  .stat-source {
    color: var(--ink-muted);
  }

  @media (max-width: 768px) {
    .stat-unit {
      font-size: 26px;
    }
  }
</style>
