---
/* One measured result.

   `figure` is null until Trevor supplies a number with a named client and a
   period, and the block renders a visible [__] placeholder in the meantime.
   That is deliberate. An unsourced number on a consulting site is worse than
   no number, and a placeholder that looks like a placeholder is the only thing
   that stops one being quietly filled with something plausible.

   The source line is always rendered, including while it says what is still
   missing. A figure without a source does not ship. */

interface Props {
  figure: string | null;
  unit: string;
  description: string;
  source: string;
}

const { figure, unit, description, source } = Astro.props;
---

<div class="stat">
  <span class="rule rule-stat" aria-hidden="true"></span>

  <p class="stat-figure">
    {
      figure ? (
        <span class="t-bignum">{figure}</span>
      ) : (
        <>
          <span class="t-bignum placeholder" aria-hidden="true">
            [__]
          </span>
          <span class="sr-only">Figure to be supplied</span>
        </>
      )
    }
    <span class="stat-unit">{unit}</span>
  </p>

  <p class="stat-description">{description}</p>
  <p class="t-caption stat-source">{source}</p>
</div>

<style>
  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .stat-figure {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    color: var(--ink);
  }

  .stat-unit {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 700;
    color: var(--ink-muted);
  }

  .stat-description {
    font-size: 18px;
    line-height: 1.5;
    color: var(--ink);
  }

  .stat-source {
    color: var(--ink-muted);
  }

  @media (max-width: 768px) {
    .stat-unit {
      font-size: 26px;
    }
  }
</style>
