---
/* The vector master now exists, so OPEN ITEM 1 is closed and the Archivo
   substitution is gone.

   THE ARTWORK
   src/assets/logo/ holds the SVG masters; public/logo/ holds the two files
   this component serves. Both are the horizontal lockup — TG, the mark as the
   M, then GROUP on the same baseline at 1.2x its stacked size. It is 4.7:1,
   which is the shape the 150x56 header slot was designed around. The stacked
   lockup (tgm-logo-primary.svg) is 1.63:1 and belongs on decks, proposals and
   advertising, not in a site header.

   Served as <img> from public/ rather than imported through astro:assets: the
   file is 23KB of path data, it never needs resizing or format negotiation,
   and referencing it by absolute path keeps this component independent of the
   Astro image pipeline.

   The dark variant is the REVERSED file, not the white one — white bars, white
   wordmark, gold arrow. The all-white file exists for single-colour print and
   embroidery and would flatten the arrow into the M here.

   Minimum width is 120px, per LOGO-NOTES.md. At size <= 20 the GROUP line
   starts to close up; the header uses 26 and the footer 22. */

interface Props {
  /* 'light' is the navy lockup for --surface.
     'dark' is the reversed lockup for --surface-deep and --surface-inverse. */
  variant?: 'light' | 'dark';
  /* Retained from the wordmark build so callers do not change: it is the
     nominal type size the lockup is scaled against. Header 26, footer 22. */
  size?: number;
  /* The header logo is a link home; the footer lockup is not. */
  as?: 'link' | 'text';
}

const { variant = 'light', size = 26, as = 'link' } = Astro.props;

const src =
  variant === 'dark'
    ? '/logo/tgm-logo-horizontal-reversed.svg'
    : '/logo/tgm-logo-horizontal.svg';

const Tag = as === 'link' ? 'a' : 'span';
const attrs = as === 'link' ? { href: '/', 'aria-label': 'TGM Group home' } : {};

/* 4.7:1. At size 26 the lockup stands 32.5px and runs 153px — inside the
   150x56 slot and above the 120px floor. */
const height = size * 1.25;
---

<Tag {...attrs} class="logo" style={`--logo-height:${height}px`}>
  <img
    src={src}
    alt={as === 'link' ? '' : 'TGM Group'}
    width="470"
    height="100"
    decoding="async"
    class="logo-lockup"
  />
</Tag>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  .logo-lockup {
    display: block;
    height: var(--logo-height);
    width: auto;
    /* The artwork carries its own colour; nothing here should tint it. */
  }
</style>
