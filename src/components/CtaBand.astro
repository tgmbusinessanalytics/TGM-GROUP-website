---
import Button from './Button.astro';
import { cta } from '../data/site';

/* The closing band. Same action as the header, the hero and the services grid
   — there is one conversion path on this site and this is the last of four
   places it appears. Do not add a second. */

interface Props {
  id?: string;
  heading?: string;
  sub?: string;
}

const {
  id = 'contact',
  heading = 'Ninety minutes. A straight answer about what is actually holding you back.',
  sub = 'No charge, no deck, no obligation to engage us afterwards.',
} = Astro.props;
---

<section id={id} class="cta-band on-dark">
  <div class="wrap cta-inner">
    <div class="cta-copy">
      <h2 class="t-h2 cta-heading">{heading}</h2>
      <p class="t-lead cta-sub">{sub}</p>
    </div>
    <Button href={cta.href} variant="gold" size="lg">{cta.label}</Button>
  </div>
</section>

<style>
  .cta-band {
    background: var(--surface-inverse);
    padding-block: var(--space-7);
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .cta-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 720px;
  }

  .cta-heading {
    color: var(--ink-inverse);
  }

  /* --ink-inverse-muted is not for use on --surface-inverse — it is only
     cleared against --surface-deep. The sub-line stays full white. */
  .cta-sub {
    color: var(--ink-inverse);
  }

  @media (max-width: 900px) {
    .cta-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-5);
    }
    .cta-band {
      padding-block: var(--section-m);
    }
  }
</style>
