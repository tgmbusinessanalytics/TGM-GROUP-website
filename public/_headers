# Cloudflare Pages / Netlify headers.
#
# Both platforms read this file from the published output root. If you deploy
# somewhere else, these rules need to be reproduced in that platform's own
# configuration — they are not part of the build.
#
# NOTE ON THE CONTACT FORM. The site currently runs on cPanel, and the form
# posts to /enquiry.php on that server. Neither Cloudflare Pages nor Netlify
# runs PHP, so moving the site to either one would leave the form posting to a
# file that is served as text rather than executed, and every enquiry would be
# lost silently. The replacement on those platforms is a Cloudflare Worker or a
# Netlify Function doing the same job. Deal with that before any such move,
# not after.

/*
  # This site loads no third-party scripts, styles, frames or fonts, so the
  # policy can be strict. 'unsafe-inline' on style-src is required by Astro's
  # scoped styles; there are no inline <style> blocks we control away.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # No feature on this site needs any of these.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# Fonts and hashed build assets never change under the same URL.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
